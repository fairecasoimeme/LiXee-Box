{
 "Shelly-Gen2-PM": [
  {
   "http": {
    "label": "Shelly Gen2/Plus avec mesure (1PM, Plug S...)",
    "vendor": "Shelly",
    "auth": "digest",
    "poll": [
     "/rpc/Switch.GetStatus?id=0"
    ],
    "detect": [
     {
      "url": "/shelly",
      "path": "gen"
     },
     {
      "url": "/rpc/Switch.GetStatus?id=0",
      "path": "apower"
     }
    ],
    "mac": {
     "url": "/shelly",
     "path": "mac"
    },
    "name": {
     "url": "/shelly",
     "path": "name"
    }
   },
   "status": [
    {
     "name": "Etat",
     "cluster": "0006",
     "attribut": 0,
     "json": "output",
     "visible": 1,
     "mqtt_device_class": "switch"
    },
    {
     "name": "Puissance",
     "cluster": "0B04",
     "attribut": 1291,
     "json": "apower",
     "mqtt_device_class": "power",
     "mqtt_icon": "lightning-bolt",
     "mqtt_state_class": "measurement",
     "type": "numeric",
     "visible": 1,
     "jauge": "gauge",
     "min": 0,
     "max": 3600,
     "unit": "W"
    },
    {
     "name": "Tension",
     "cluster": "0B04",
     "attribut": 1285,
     "json": "voltage",
     "scale": 10,
     "coefficient": 0.1,
     "mqtt_device_class": "voltage",
     "mqtt_icon": "sine-wave",
     "mqtt_state_class": "measurement",
     "type": "numeric",
     "visible": 1,
     "unit": "V"
    },
    {
     "name": "Courant",
     "cluster": "0B04",
     "attribut": 1288,
     "json": "current",
     "scale": 1000,
     "coefficient": 0.001,
     "mqtt_device_class": "current",
     "mqtt_icon": "current-ac",
     "mqtt_state_class": "measurement",
     "type": "numeric",
     "visible": 1,
     "unit": "A"
    },
    {
     "name": "Energie",
     "cluster": "0702",
     "attribut": 0,
     "json": "aenergy.total",
     "scale": 1,
     "mqtt_device_class": "energy",
     "mqtt_icon": "transmission-tower",
     "mqtt_state_class": "total_increasing",
     "type": "numeric",
     "visible": 1,
     "jauge": "text",
     "unit": "Wh"
    }
   ],
   "action": [
    {
     "name": "ON",
     "command": 146,
     "endpoint": 1,
     "value": 1,
     "http": "/rpc/Switch.Set?id=0&on=true"
    },
    {
     "name": "OFF",
     "command": 146,
     "endpoint": 1,
     "value": 0,
     "http": "/rpc/Switch.Set?id=0&on=false"
    },
    {
     "name": "TOGGLE",
     "command": 146,
     "endpoint": 1,
     "value": 2,
     "http": "/rpc/Switch.Toggle?id=0"
    }
   ]
  }
 ],
