# Variables statiques non initialisees (.bss / COMMON) placees en PSRAM.
#
# La RAM interne (DIRAM) est la ressource rare du pont : piles des taches qui
# touchent la flash, tampons DMA, WiFi, pile TCP/IP. Le schema extram_bss
# (defini par esp_wifi, utilise par lwip/net80211/wpa_supplicant) envoie le
# .bss d'une bibliotheque entiere dans extern_ram ; les .data (valeurs
# initialisees) restent en interne.
#
# Conditions verifiees pour chaque bibliotheque listee :
#  - aucune pile ni TCB de tache en statique (interdits en PSRAM) ;
#  - aucune variable lue par une interruption IRAM ou pendant une operation
#    flash (cache coupe) : l'ISR LoRa (DIO1) est enregistree sans
#    ESP_INTR_FLAG_IRAM, le SPI LoRa est en polling sans DMA ;
#  - aucun tampon DMA statique (ceux du W5500 sont alloues par le pilote).
# Les objets FreeRTOS statiques (StaticSemaphore_t de CHIP) sont admis en PSRAM.
#
# Exclus : mdns (TCB statique de sa tache), libbtdm_app (impose en interne par
# l'IDF), wifi_manager / eth_manager (configuration passee aux pilotes).

[mapping:psram_bss_esp_matter]
archive: libespressif__esp_matter.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (extram_bss)

[mapping:psram_bss_main]
archive: libmain.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (extram_bss)

