# =============================================================================
# LiXee MatterBridge - sdkconfig.defaults
# Configuration ESP-IDF v5.3+ pour pont Matter/Zigbee
#
# Usage :
#   idf.py set-target esp32s3
#   idf.py menuconfig   (optionnel, pour ajuster)
#   idf.py build
# =============================================================================

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# --- PSRAM (Octal, 8MB sur DevKitC-1) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Flash (16 MB, DIO) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Partition table personnalisee ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# --- WiFi ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# --- LwIP (pile reseau IPv4 + IPv6, requis par Matter) ---
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_LOCAL_HOSTNAME="LiXee-MatterBridge"
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8

# --- mDNS ---
CONFIG_MDNS_MULTIPLE_INSTANCE=y

# --- NVS ---
CONFIG_NVS_ENCRYPTION=n

# --- UART ---
# Console sur UART0 (defaut), UART1 reserve pour ZiGate
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- HTTP Server ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_STACK_SIZE=8192
CONFIG_HTTPD_WS_SUPPORT=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=y

# --- Bluetooth (BLE pour commissioning Matter) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# =============================================================================
# Matter (CHIP / ConnectedHomeIP via esp-matter)
# =============================================================================

CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_CHIP_TASK_STACK_SIZE=8192

# Endpoints dynamiques : racine (0) + agregateur (1) + 32 appareils pontes
# (CONFIG_MATTER_BRIDGE_MAX_DEVICES). La valeur par defaut d'esp-matter (16)
# limitait le pont a 14 appareils.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=34

# mDNS d'ESP-IDF partage avec le pont (LIXEEBOX-XXYY.local pour LiXee-Assist).
# Le mDNS minimal de CHIP ouvre son propre socket UDP 5353, deja pris par ce
# composant : Matter ne pouvait alors pas s'annoncer ("Failed to initialize
# advertiser") et aucun controleur ne trouvait le pont.
CONFIG_USE_MINIMAL_MDNS=n

# RAM interne : Matter, CHIP, mDNS et NimBLE allouaient en RAM interne, que la
# PSRAM (8 Mo) laissait presque vide. Epuisee, elle faisait echouer le
# Bluetooth puis redemarrer le pont en boucle (chiffrement, sockets).
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Tampons WiFi statiques (DMA, RAM interne obligatoire) : 16 -> 10
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
# Code WiFi en flash plutot qu'en IRAM (~20 Ko de RAM interne rendus ; debit
# un peu plus faible, sans importance pour le pont)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Pas de commissioning Matter par Bluetooth (~50-60 Ko de RAM interne pour le
# controleur BLE) : le pont est deja sur le reseau (WiFi provisionne par
# LiXee-Assist, ou Ethernet) et Home Assistant l'ajoute par le reseau. Le
# provisioning WiFi BLE de LiXee-Assist garde son propre NimBLE, avant Matter.
CONFIG_ENABLE_CHIPOBLE=n

# BLE reste actif apres commissioning Matter (necessaire pour BLE provisioning WiFi)
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# OTA Matter (mise a jour firmware via le reseau)
CONFIG_ENABLE_OTA_REQUESTOR=y

# OpenThread desactive (Zigbee gere par ZiGate externe, pas Thread natif)
CONFIG_OPENTHREAD_ENABLED=n

# =============================================================================
# Securite / mbedTLS (requis par Matter)
# =============================================================================
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_PKCS5_C=y
# AES logiciel : l'AES materiel alloue a chaque operation un tampon DMA en RAM
# interne, et son echec ("esp-aes: Failed to allocate memory") arretait le pont.
CONFIG_MBEDTLS_HARDWARE_AES=n
# Allocations mbedTLS en PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# =============================================================================
# LittleFS (composant joltwallet/littlefs)
# =============================================================================
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# Tunnel distant : une socket client + une session httpd par requete relayee,
# en plus de la socket TLS du tunnel
CONFIG_LWIP_MAX_SOCKETS=16

# Variables statiques marquees EXT_RAM_BSS_ATTR en PSRAM (table des appareils Zigbee)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Tache principale : sequence d init ZiGate, init LoRa (template + sauvegarde),
# notifications_tick / rules_tick (ecritures de fichiers JSON)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Cache des pages NVS en PSRAM (RAM interne economisee)
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

# Identite Matter du pont (fabricant, produit) : main/CHIPProjectConfig.h
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"
CONFIG_DEVICE_SOFTWARE_VERSION_NUMBER=3

# Code d appairage Matter propre a chaque passerelle (matter_bridge.cpp)
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
